# One key covers Claude + GPT + Gemini via the Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Read-only PAT (public_repo) for fetching PR diffs.
GITHUB_TOKEN=

# Local Supabase (run `pnpm db:start`, then `pnpm db:status` for the values).
SUPABASE_URL=http://127.0.0.1:54321
# Direct Postgres connection to the durable state store (runs + findings).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# HITL publish target: "output" (default, read-only) or "github" (posts a real
# PR comment — requires a write-scoped token below).
PUBLISH_MODE=output
GITHUB_WRITE_TOKEN=

# Optional: Langfuse tracing. Unset = spans emitted but not exported.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
